generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum ServiceType {
  DATA
  AIRTIME
  ELECTRICITY
  CABLE_TV
  BETTING
  EXAM_PIN
  BULK_SMS
}

enum Network {
  MTN
  AIRTEL
  GLO
  NINE_MOBILE
}

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
}

model User {
  id                  String               @id @default(cuid())
  fullName            String
  email               String               @unique
  phone               String               @unique
  passwordHash        String
  role                Role                 @default(USER)
  walletBalance       Decimal              @default(0) @db.Decimal(12, 2)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  walletTransactions  WalletTransaction[]
  serviceTransactions ServiceTransaction[]
  payments            Payment[]

  @@index([role])
  @@index([createdAt])
}

model WalletTransaction {
  id            String                  @id @default(cuid())
  userId        String
  type          WalletTransactionType
  amount        Decimal                 @db.Decimal(12, 2)
  balanceBefore Decimal                 @db.Decimal(12, 2)
  balanceAfter  Decimal                 @db.Decimal(12, 2)
  reference     String                  @unique
  status        TransactionStatus       @default(PENDING)
  description   String
  createdAt     DateTime                @default(now())
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model ServiceTransaction {
  id                String            @id @default(cuid())
  userId            String
  serviceType       ServiceType
  network           Network?
  phoneNumber       String?
  planId            String?
  amount            Decimal           @db.Decimal(12, 2)
  providerCost      Decimal           @db.Decimal(12, 2)
  profit            Decimal           @db.Decimal(12, 2)
  reference         String            @unique
  providerReference String?
  status            TransactionStatus @default(PENDING)
  responseMessage   String?
  createdAt         DateTime          @default(now())
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              DataPlan?         @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([serviceType, status])
}

model DataPlan {
  id                  String               @id @default(cuid())
  network             Network
  name                String
  dataSize            String
  validity            String
  providerCode        String               @unique
  providerCost        Decimal              @db.Decimal(12, 2)
  sellingPrice        Decimal              @db.Decimal(12, 2)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  serviceTransactions ServiceTransaction[]

  @@index([network, isActive])
}

model Payment {
  id        String            @id @default(cuid())
  userId    String
  amount    Decimal           @db.Decimal(12, 2)
  gateway   PaymentGateway
  reference String            @unique
  status    TransactionStatus @default(PENDING)
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([gateway, status])
}
