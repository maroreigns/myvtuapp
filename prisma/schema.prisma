generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum ServiceType {
  DATA
  AIRTIME
  ELECTRICITY
  CABLE_TV
  BETTING
  EXAM_PIN
  BULK_SMS
  AIRTIME_TO_CASH
  RECHARGE_CARD
}

enum Network {
  MTN
  AIRTEL
  GLO
  NINE_MOBILE
}

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
}

enum RechargeCardStatus {
  UNUSED
  PRINTED
  SOLD
}

model User {
  id                  String               @id @default(cuid())
  fullName            String
  email               String               @unique
  phone               String               @unique
  passwordHash        String
  role                Role                 @default(USER)
  walletBalance       Decimal              @default(0) @db.Decimal(12, 2)
  emailVerifiedAt     DateTime?
  isActive            Boolean              @default(true)
  referralCode        String?              @unique
  referredById        String?
  referralEarnings    Decimal              @default(0) @db.Decimal(12, 2)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  walletTransactions  WalletTransaction[]
  serviceTransactions ServiceTransaction[]
  payments            Payment[]
  referredBy          User?                @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]               @relation("UserReferrals")
  referralBonuses     ReferralEarning[]    @relation("ReferralBeneficiary")
  earnedBonuses       ReferralEarning[]    @relation("ReferralReferredUser")
  verificationTokens  VerificationToken[]
  smsLogs             SmsLog[]

  @@index([role])
  @@index([isActive])
  @@index([referralCode])
  @@index([createdAt])
}

model WalletTransaction {
  id            String                  @id @default(cuid())
  userId        String
  type          WalletTransactionType
  amount        Decimal                 @db.Decimal(12, 2)
  balanceBefore Decimal                 @db.Decimal(12, 2)
  balanceAfter  Decimal                 @db.Decimal(12, 2)
  reference     String                  @unique
  status        TransactionStatus       @default(PENDING)
  description   String
  createdAt     DateTime                @default(now())
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model ServiceTransaction {
  id                String            @id @default(cuid())
  userId            String
  serviceType       ServiceType
  network           Network?
  phoneNumber       String?
  planId            String?
  amount            Decimal           @db.Decimal(12, 2)
  providerCost      Decimal           @db.Decimal(12, 2)
  profit            Decimal           @db.Decimal(12, 2)
  reference         String            @unique
  providerReference String?
  status            TransactionStatus @default(PENDING)
  responseMessage   String?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              DataPlan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  vtuLogs           VtuApiLog[]
  referralEarnings  ReferralEarning[]

  @@index([userId, createdAt])
  @@index([serviceType, status])
  @@index([network, serviceType])
}

model DataPlan {
  id                  String               @id @default(cuid())
  network             Network
  name                String
  dataSize            String
  validity            String
  providerCode        String               @unique
  providerCost        Decimal              @db.Decimal(12, 2)
  sellingPrice        Decimal              @db.Decimal(12, 2)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  serviceTransactions ServiceTransaction[]

  @@index([network, isActive])
}

model Payment {
  id               String            @id @default(cuid())
  userId           String
  amount           Decimal           @db.Decimal(12, 2)
  gateway          PaymentGateway
  gatewayReference String?
  reference        String            @unique
  status           TransactionStatus @default(PENDING)
  paidAt           DateTime?
  failureReason    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([gateway, status])
}

model AirtimePricing {
  id             String   @id @default(cuid())
  network        Network  @unique
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  providerCostPercent Decimal @default(98) @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  type      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model ReferralCommissionSetting {
  id          String   @id @default(cuid())
  serviceType ServiceType?
  percentage  Decimal  @default(1.5) @db.Decimal(5, 2)
  flatAmount  Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([serviceType])
}

model ReferralEarning {
  id                   String             @id @default(cuid())
  beneficiaryUserId    String
  referredUserId       String
  serviceTransactionId String
  amount               Decimal            @db.Decimal(12, 2)
  status               TransactionStatus  @default(SUCCESSFUL)
  createdAt            DateTime           @default(now())
  beneficiary          User               @relation("ReferralBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)
  referredUser         User               @relation("ReferralReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  serviceTransaction   ServiceTransaction @relation(fields: [serviceTransactionId], references: [id], onDelete: Cascade)

  @@unique([beneficiaryUserId, serviceTransactionId])
  @@index([referredUserId])
}

model SmsLog {
  id          String    @id @default(cuid())
  userId      String?
  phone       String
  message     String
  provider    String
  status      SmsStatus @default(PENDING)
  providerRef String?
  error       String?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([status])
}

model VtuApiLog {
  id                   String              @id @default(cuid())
  serviceTransactionId String?
  provider             String
  serviceType          ServiceType
  requestPayload       Json
  responsePayload      Json?
  status               TransactionStatus
  error                String?
  createdAt            DateTime            @default(now())
  serviceTransaction   ServiceTransaction? @relation(fields: [serviceTransactionId], references: [id], onDelete: SetNull)

  @@index([serviceType, createdAt])
  @@index([status])
}

model RechargeCardBatch {
  id          String         @id @default(cuid())
  name        String
  network     Network
  denomination Decimal      @db.Decimal(12, 2)
  createdAt   DateTime      @default(now())
  cards       RechargeCard[]
}

model RechargeCard {
  id           String             @id @default(cuid())
  batchId      String
  pin          String
  serialNumber String             @unique
  status       RechargeCardStatus @default(UNUSED)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  batch        RechargeCardBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, status])
}
